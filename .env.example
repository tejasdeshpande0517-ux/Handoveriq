# ============================================================================
# HANDOVERIQ — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in the required credentials.
# IMPORTANT: Never commit your actual .env file or expose server keys to VITE_!
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SERVER-SIDE AI & EXTERNAL API CREDENTIALS (Cloud Functions / Backend Only)
# ----------------------------------------------------------------------------
# Required for Google Gemini AI structured analysis, embeddings, and RAG Q&A.
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Optional / Recommended for GitHub repository ingestion (required for private repos
# and higher API rate limits). Scope needed: repo, read:user
# Obtain from GitHub Settings > Developer settings > Personal access tokens
GITHUB_TOKEN=

# Secret key used by the backend for signing session tokens and reset tokens
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Port for local backend Cloud Functions & Firestore API runner
PORT=3001

# ----------------------------------------------------------------------------
# 2. FIREBASE CLIENT CONFIGURATION (Frontend Web SDK)
# ----------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=handoveriq-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=handoveriq-prod
VITE_FIREBASE_STORAGE_BUCKET=handoveriq-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to connect the Firebase Web SDK to the local Firebase Emulator Suite
VITE_USE_FIREBASE_EMULATOR=false

