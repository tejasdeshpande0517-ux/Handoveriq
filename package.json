{
  "name": "handoveriq",
  "private": true,
  "version": "1.0.0",
  "description": "HandoverIQ — AI-Assisted, Source-Backed, Leader-Verified Project Handover Management Platform",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
